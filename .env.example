# ==============================================================================
# GLOBAL CRICKET DREAM GAME - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development: cp .env.example .env
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Backend API URL (for frontend communication)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws/matches

# PostgreSQL Database Configuration
# Local Docker or native PostgreSQL
POSTGRES_USER=cricket_admin
POSTGRES_PASSWORD=cricket_dev_secret_2026
POSTGRES_DB=cricket_game_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Prisma Database Connection URL
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# Redis Configuration (Optional in local development - in-memory fallback enabled)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=false

# Authentication & JWT Secrets
JWT_SECRET=cricket_super_secure_jwt_dev_secret_key_2026_min32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cricket_super_secure_jwt_refresh_dev_secret_key_2026_min32chars
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
