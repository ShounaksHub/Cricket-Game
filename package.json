{
  "name": "cricket-dream-game-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Global Cricket Dream Team & Simulation Game - Monorepo",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @cricket/database db:generate",
    "db:push": "pnpm --filter @cricket/database db:push",
    "db:migrate": "pnpm --filter @cricket/database db:migrate"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "packageManager": "pnpm@12.18.0"
}
